rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function isStaff() { return role() in ['teacher', 'admin']; }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isStaff());
      allow create, update, delete: if false;
    }

    match /usernames/{username} {
      allow read, write: if false;
    }

    match /attendance/{recordId} {
      allow read: if signedIn() &&
        (resource.data.uid == request.auth.uid || isStaff());
      allow create, update, delete: if false;
    }

    match /assignments/{assignmentId} {
      allow read: if signedIn();
      allow write: if signedIn() && isStaff();
    }

    match /materials/{materialId} {
      allow read: if signedIn();
      allow write: if signedIn() && isStaff();
    }

    match /submissions/{submissionId} {
      allow read: if signedIn() &&
        (resource.data.studentUid == request.auth.uid || isStaff());
      allow create: if signedIn() &&
        role() == 'student' &&
        request.resource.data.studentUid == request.auth.uid;
      allow update, delete: if signedIn() && isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
