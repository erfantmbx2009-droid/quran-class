rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() ? request.auth.token.role : null; }
    function staff() { return role() in ['teacher', 'admin']; }

    match /materials/{allPaths=**} {
      allow read: if signedIn();
      allow write: if staff() &&
        request.resource.size < 100 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*|audio/.*|video/.*');
    }

    match /submissions/{uid}/{allPaths=**} {
      allow read: if signedIn() && (request.auth.uid == uid || staff());
      allow write: if signedIn() &&
        (request.auth.uid == uid && role() == 'student') &&
        request.resource.size < 50 * 1024 * 1024 &&
        request.resource.contentType.matches('application/pdf|image/.*|audio/.*|video/.*');
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
